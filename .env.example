# ─── Shopify App Credentials ───────────────────────────────────────────────────
# Your store's .myshopify.com subdomain (NOT your custom domain)
# Find it at: https://admin.shopify.com/store/YOUR-HANDLE → use YOUR-HANDLE.myshopify.com
SHOPIFY_STORE=your-store.myshopify.com

# From Shopify Partners → Your App → Client credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Leave blank — populated automatically after running: python shopify_report.py --auth
SHOPIFY_ACCESS_TOKEN=

# ─── AWS SES ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave blank to use the default profile from ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email ─────────────────────────────────────────────────────────────────────
# Must be SES-verified. In sandbox mode, TO_EMAILS must also be verified.
FROM_EMAIL=you@example.com

# Comma-separated list of recipients
TO_EMAILS=you@example.com

# ─── Report Settings ───────────────────────────────────────────────────────────
# Number of days to include in the report
REPORT_DAYS=30
